# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=repousse_dev
DB_HOST=localhost

# Phoenix
SECRET_KEY_BASE=  # generate with: mix phx.gen.secret
PHX_HOST=localhost

# Hanko (passwordless auth)
NEXT_PUBLIC_HANKO_API_URL=http://localhost:8000
HANKO_API_URL=http://localhost:8000

# HelloAsso integration
HELLOASSO_API_URL=
HELLOASSO_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Parallel worktree stacks — only needed when running a second docker-compose
# stack alongside the main one (see scripts/worktree-env.sh). Leave unset for
# the main checkout; the values above are the defaults each falls back to.
# COMPOSE_PROJECT_NAME=repousse
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025
# HANKO_PUBLIC_PORT=8000
# HANKO_ADMIN_PORT=8001
# BACKEND_PORT=4000
# FRONTEND_PORT=3000
